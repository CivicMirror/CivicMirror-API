# Django
DJANGO_SECRET_KEY=django-insecure-change-me-for-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (defaults to SQLite if not set)
DATABASE_URL=postgres://civicmirror:civicmirror@localhost:5432/civicmirror_api

# Redis (used by Celery)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Internal task auth (ADR-002 — shared secret for dev/CI; use OIDC in prod)
INTERNAL_TASK_TOKEN=change-me-for-development

# API key auth (X-Api-Key header): every client uses its own DB-backed key (ADR-010).
# Create one with `python manage.py create_api_key --name local-dev --access read_write`.
# Default rate limit for service keys without their own throttle_rate ('none' disables).
CIVICMIRROR_API_KEY_DEFAULT_RATE=1000/hour
# Public-participation rate limits (#202). Defaults shown; 'none' disables a scope.
# THROTTLE_RATE_REGISTER_IP=5/hour
# THROTTLE_RATE_LOGIN_IP=30/hour
# THROTTLE_RATE_LOGIN_USERNAME=20/hour
# THROTTLE_RATE_VOTE_USER=120/hour
# THROTTLE_RATE_VOTE_IP=600/hour
# THROTTLE_RATE_COMMUNITY_CREATE_USER=10/day
# THROTTLE_RATE_COMMUNITY_CREATE_IP=30/day
# request.META key holding the real client IP (Cloudflare). Blank disables IP-based limits.
CIVICMIRROR_CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
# Optional: trust X-Forwarded-For, taking the Nth entry from the right (0 = off).
CIVICMIRROR_CLIENT_IP_XFF_PROXIES=0
# Optional: separate Redis URL for rate-limit counters (defaults to REDIS_URL).
# THROTTLE_CACHE_URL=
# Cloudflare Turnstile on registration. Leave blank to disable; set only after the FrontEnd sends tokens.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=register

# External API keys
CIVIC_API_KEY=
FEC_API_KEY=
OPENSTATES_API_KEY=
GITHUB_TOKEN=

# Google Civic API settings
CIVIC_API_BASE=https://www.googleapis.com/civicinfo/v2
CIVIC_HTTP_TIMEOUT_SECONDS=10
CIVIC_MAX_RETRIES=3
CIVIC_RETRY_BACKOFF_SECONDS=1.0

# Gmail API (ADR-005 — Phase 6, VIP email monitoring)
GMAIL_SERVICE_ACCOUNT_JSON=
VIP_GMAIL_WATCH_TOPIC=
GMAIL_WATCH_USER_ID=

# Logging
LOG_LEVEL=INFO

# Firebase Authentication (v1.1 — mock voting + community races)
# Set FIREBASE_AUTH_ENABLED=False for local dev without Firebase project
FIREBASE_AUTH_ENABLED=False
# Path to service account JSON; leave blank to use Application Default Credentials (Cloud Run)
FIREBASE_CREDENTIALS_FILE=
